# Port for the worker HTTP + WebSocket server (Railway sets PORT automatically)
PORT=8080

# Shared secret between the deck and the worker. Paste the same value in
# ViralDeck → Worker card → Token.
WORKER_TOKEN=change-me-to-a-long-random-string

# Groq API key (https://console.groq.com). Without it the engine runs with
# heuristic quality checks and no AI captions.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Official YouTube Data API uploads (all four are separate Railway variables).
# The client secret stays server-side; never paste it into the deck or a chat.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Either name works; this Railway service currently uses GOOGLE_REDIRECT_URL.
GOOGLE_REDIRECT_URL=https://your-service.up.railway.app/callback
# GOOGLE_REDIRECT_URI=https://your-service.up.railway.app/callback
# GOOGLE_SCOPES is preferred; SCOPES is also accepted for existing deploys.
GOOGLE_SCOPES=https://www.googleapis.com/auth/youtube.upload
# Optional stable encryption key for refresh-token files. Set this before the
# first connection only; changing it requires reconnecting each YouTube account.
# If empty, the worker derives encryption from GOOGLE_CLIENT_SECRET.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# One resumable YouTube upload deadline (minutes). Default 15.
YOUTUBE_UPLOAD_TIMEOUT_MIN=15

# Where browser profiles (your logins) + engine state are stored.
# Mount a Railway volume here so sessions survive restarts.
STORAGE_DIR=./data

# Screenshot stream cadence for the live browser view (ms).
FRAME_INTERVAL_MS=1200

# ---------------------------------------------------------------------------
# Tor account proxies
# ---------------------------------------------------------------------------

# The Docker image starts Tor automatically. Every platform/account gets a
# separate loopback HTTP CONNECT bridge whose unique SOCKS credentials are
# isolated by Tor's IsolateSOCKSAuth. Chromium cannot silently fall back to the
# host IP: browser launch waits for a Tor egress check and aborts if it fails.
TOR_PROXY_ENABLED=true
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050
# Maximum startup wait for Tor bootstrap + fail-closed egress proof.
TOR_BOOTSTRAP_TIMEOUT_MS=90000
# Optional override. Docker defaults to $STORAGE_DIR/tor-client so Tor can reuse
# its cached consensus after a deploy instead of cold-bootstrapping every time.
# TOR_DATA_DIR=/app/data/tor-client

# Explicit false is intended only for local development without Tor. It is
# logged as a direct-network warning and must not be used for production.
# TOR_PROXY_ENABLED=false

# ---------------------------------------------------------------------------
# Browser engine
# ---------------------------------------------------------------------------

# Which browser the worker launches.
#   playwright (default) — stock Chromium, pulled by Playwright at build time.
#       Loads pages ~as fast as your machine allows, no custom binary to fetch,
#       and the input path is still our own (CDP trusted events + human motor
#       model in human.ts). This is the engine to use unless a site is actively
#       rejecting you.
#   clearcote           — the anti-fingerprint build: spoofing compiled into
#       Chromium's C++, light-stealth patches, ~150 MB download at build time
#       (Docker: --build-arg WITH_CLEARCOTE=true).
# Both read the SAME persistent profile dir, so flipping this keeps your logins.
BROWSER_ENGINE=playwright

# Playwright's browser cache. Set in the image; point it at a mounted path if
# you want to keep browser binaries across rebuilds.
PLAYWRIGHT_BROWSERS_PATH=/opt/playwright

# Use a specific Chromium binary instead of the one Playwright installed — e.g.
# a system chromium, or a branded Chrome. Missing paths are reported at boot.
CHROME_PATH=

# Third-party requests are most of a page's load time on these sites: analytics,
# ad SDKs, consent managers, pixel beacons. The launcher blocks ~35 of them by
# hostname at the resolver level (no connection is even attempted). Set to "off"
# if a page starts looking broken or a login flow depends on one.
BLOCK_TRACKERS=on

# ---------------------------------------------------------------------------
# Stealth / driver (persona, human input; the clearcote-only knobs are marked)
# ---------------------------------------------------------------------------

# Where the verified Clearcote browser binary is cached. The Docker image
# pre-downloads it here at build time; locally it can be left empty to use
# the SDK's default cache.
CLEARCOTE_CACHE_DIR=/app/.clearcote-browser

# LD_PRELOAD shim that makes setpriority() a no-op. Containers lack
# CAP_SYS_NICE, so setpriority() returns EPERM — and the Clearcote
# pre-release binary (DCHECK-enabled) fatals on that where a release
# Chromium would silently ignore it. The Docker image builds the shim and
# sets this automatically; leave it empty anywhere else.
STEALTH_NICE_SHIM=/app/nice-shim.so

# Pin a Clearcote browser build ("149", "latest", …) — clearcote engine only.
# Empty = the SDK's pinned release.
CLEARCOTE_BROWSER_VERSION=

# Fingerprint persona OS. Defaults to "linux" — the coherent default for the
# Linux Clearcote binary (Clearcote's own container defaults to linux).
# "windows" on a Linux host is only coherent together with a Windows-captured
# fingerprint profile; without one the SDK warns and font/canvas hashes won't
# match a real Windows Chrome.
STEALTH_PLATFORM=linux

# Optional base for per-account fingerprint seeds. Defaults to
# "viraldeck-<platform>-<account>-<token>" so every isolated account gets a
# stable identity. DO NOT change it once accounts are logged in.
STEALTH_FINGERPRINT=

# Coherent metadata spoof (hardwareConcurrency, deviceMemory, DPR, colorDepth,
# maxTouchPoints) applied via native switches only — survives strict bot
# checks. Default on.
STEALTH_LIGHT=true

# Humanize ALL input as native trusted events with a seed-derived motor
# persona (minimum-jerk cursor paths, Fitts timing, tremor, typos, thinking
# pauses). Default on.
STEALTH_HUMANIZE=true

# Red cursor dot in the live stream so you can watch the humanized motion.
STEALTH_SHOW_CURSOR=false

# Headed vs headless. The Docker image runs HEADED under Xvfb
# (STEALTH_HEADLESS=false): a real window avoids headless-mode tells, and the
# deck's frame stream and tap mapping are both built around a real window.
# The entrypoint starts Xvfb; if the entrypoint is bypassed, the worker boots
# Xvfb itself when it finds headed mode without a DISPLAY. Unset = headless.
STEALTH_HEADLESS=true

# Memory. A TikTok studio tab runs 600-900 MB, and on a small container Chromium
# starts ending renderers to stay under its ceiling. Do not guess the cause from
# this file, though: every crash line the worker prints carries the container's
# memory numbers AND Chromium's own log tail, which is the only honest way to tell
# an out-of-memory death from a renderer the browser chose to drop. 1 GB works,
# 2 GB is comfortable, headless costs roughly 40% less.


# V8 heap ceiling per renderer, in MB. When a page's JS hits this ceiling V8
# aborts the renderer: the tab dies with "Target crashed" and the kernel OOM
# counter stays at ZERO — that is how you can tell the two apart in the log.
# Default scales with the container (~30% of its memory, 512..2560 MB), which is
# what TikTok's upload studio needs: a fixed 384 MB cap killed the tab the moment
# a 20 MB file was handed to it. Pin this only if the box is unusual.
STEALTH_V8_HEAP_MB=

# Keep Chromium's per-site renderer isolation on even in a small container. With
# it OFF (the default under 3 GB) Chromium may *discard* a renderer to stay inside
# --renderer-process-limit, which looks like "Target crashed" with plenty of free
# memory. Set true if tabs die at 5% memory usage; set false to force the diet on a
# big box. Unset = diet only below 3000 MB of container memory.
STEALTH_SITE_ISOLATION=

# What a grabbed source video may weigh before the deck refuses it. Keep it well
# under the container's spare memory: the studio decodes the file for its preview,
# so a 200 MB "clip" is a crash waiting to happen (and is not a short-form post
# anyway). Default 120 MB.
VD_MAX_VIDEO_MB=120

# Adaptive quality master (default): inspect resolution, bitrate and sampled
# luminance; low-quality/dark sources become a 1080p H.264 CRF-16 upload with
# exposure/color correction, mild denoise, Lanczos scaling and sharpening.
# `always` processes even an already-clean 1080p source; `off` keeps source bytes.
VD_VIDEO_ENHANCE=adaptive
# Hard wall for one ffmpeg enhancement job. Default 12 minutes.
VD_ENHANCE_TIMEOUT_MIN=12

# Coherent locale/geo for the persona.
STEALTH_TIMEZONE=America/New_York
STEALTH_LANG=en-US,en

# Idle drift: ambient cursor motion + occasional micro-scrolls on the
# logged-in session so the account never looks parked. Default on.
STEALTH_IDLE_DRIFT=true

# Human scheduling: the 1-post/hour rule always holds, but every slot gets a
# random upward jitter so nothing happens on a metronome beat.
# Extra minutes added on top of each hourly post slot (0 disables).
STEALTH_CADENCE_JITTER_MIN=9
# Random 0-N minutes before the first automatic action after arm/boot.
STEALTH_BOOT_DELAY_MAX_MIN=8
# Random 0-N extra minutes before a metrics read counts as "due".
STEALTH_METRICS_JITTER_MIN=4
